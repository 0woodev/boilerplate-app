# ============================================================
# dev 환경용 설정 — `cp dev.sample.env dev.env` 후 값 채움
# ============================================================
PROJECT_NAME="my-project"
STAGE="dev"
DOMAIN="your-domain.com"

# ============================================================
# GitHub
# GITHUB_OWNER_TYPE: "user" | "org"
# GITHUB_VISIBILITY: "public" | "private"
#
# 인증:
#   - GitHub API (gh CLI): `gh auth login` 사전 실행 필요
#   - git clone/push: SSH 키가 ~/.ssh/ 에 있고 GitHub 에 등록되어 있어야 함
# ============================================================
GITHUB_OWNER="your-github-username"
GITHUB_OWNER_TYPE="user"
GITHUB_VISIBILITY="public"

# ============================================================
# Boilerplate 소스 레포 (변경 불필요)
# ============================================================
BOILERPLATE_OWNER="0woodev"
BOILERPLATE_FE_REPO="boilerplate-fe"
BOILERPLATE_BE_REPO="boilerplate-be"

# ============================================================
# AWS
# ============================================================
AWS_REGION="ap-northeast-2"
AWS_ACCOUNT_ID=""

# ============================================================
# Derived (자동 계산 — 수정 불필요)
# ============================================================
FE_REPO_NAME="${PROJECT_NAME}-fe"
BE_REPO_NAME="${PROJECT_NAME}-be"
TF_STATE_BUCKET="${GITHUB_OWNER}-${PROJECT_NAME}-tf-state"

# ============================================================
# Domain pattern (dev)
#   FE: {project}-dev.{domain}
#   BE: {project}-api-dev.{domain}    ← BE 는 항상 -api 가 먼저
# ============================================================
FE_DOMAIN="${PROJECT_NAME}-dev.${DOMAIN}"
BE_DOMAIN="${PROJECT_NAME}-api-dev.${DOMAIN}"

# Full URL 형태 (FE 빌드 시 VITE_BE_URL 로 주입됨, CORS 설정 등에도 사용)
FE_URL="https://${FE_DOMAIN}"
BE_URL="https://${BE_DOMAIN}"
