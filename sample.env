# ============================================================
# Project
# ============================================================
PROJECT_NAME="my-project"
STAGE=""
DOMAIN="your-domain.com"

# ============================================================
# GitHub
# GITHUB_OWNER_TYPE: "user" | "org"
# GITHUB_VISIBILITY: "public" | "private"
#
# 인증:
#   - GitHub API 호출(레포 생성 등) → `gh` CLI 를 사용하므로 사전에
#     `gh auth login` 로 로그인되어 있어야 함.
#   - git clone/push → SSH (git@github.com:...) 사용. ~/.ssh/ 에 GitHub 에
#     등록된 키가 있어야 함.
#   - PAT(GITHUB_TOKEN) 은 스크립트에서 더 이상 사용하지 않음.
# ============================================================
GITHUB_OWNER="your-github-username"
GITHUB_OWNER_TYPE="user"
GITHUB_VISIBILITY="public"

# ============================================================
# Boilerplate 소스 레포 (변경 불필요)
# ============================================================
BOILERPLATE_OWNER="0woodev"
BOILERPLATE_FE_REPO="boilerplate-fe"
BOILERPLATE_BE_REPO="boilerplate-be"

# ============================================================
# AWS
# ============================================================
AWS_REGION="ap-northeast-2"
AWS_ACCOUNT_ID=""

# ============================================================
# Derived (자동 계산 - 수정 불필요)
# ============================================================
FE_REPO_NAME="${PROJECT_NAME}-fe"
BE_REPO_NAME="${PROJECT_NAME}-be"

# ── GitHub Actions Repository variables ─────────────────────
TF_STATE_BUCKET="${GITHUB_OWNER}-${PROJECT_NAME}-tf-state"

# ── GitHub Actions Environment variables (stage별 다른 값) ──
# FE_DOMAIN: 전체 URL 형식 (https:// 포함)
#   dev  예시: https://{app}-dev.0woodev.com
#   prod 예시: https://{app}.0woodev.com
FE_DOMAIN="https://${PROJECT_NAME}-${STAGE}.${DOMAIN}"

# BE_DOMAIN: 호스트명만 (https:// 제외)
#   dev  예시: {app}-dev-api.0woodev.com
#   prod 예시: {app}-api.0woodev.com  ← prod은 stage suffix 없음
BE_DOMAIN="${PROJECT_NAME}-${STAGE}-api.${DOMAIN}"
