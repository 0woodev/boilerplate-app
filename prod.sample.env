# ============================================================
# prod 환경용 설정 — `cp prod.sample.env prod.env` 후 값 채움
# ============================================================
PROJECT_NAME="my-project"
STAGE="prod"
DOMAIN="your-domain.com"

# ============================================================
# GitHub (dev.env 과 동일 값)
# ============================================================
GITHUB_OWNER="your-github-username"
GITHUB_OWNER_TYPE="user"
GITHUB_VISIBILITY="public"

BOILERPLATE_OWNER="0woodev"
BOILERPLATE_FE_REPO="boilerplate-fe"
BOILERPLATE_BE_REPO="boilerplate-be"

# ============================================================
# AWS (dev.env 과 동일 값 가능, 또는 prod 별도 계정)
# ============================================================
AWS_REGION="ap-northeast-2"
AWS_ACCOUNT_ID=""

# ============================================================
# Derived (자동 계산 — 수정 불필요)
# ============================================================
FE_REPO_NAME="${PROJECT_NAME}-fe"
BE_REPO_NAME="${PROJECT_NAME}-be"
TF_STATE_BUCKET="${GITHUB_OWNER}-${PROJECT_NAME}-tf-state"

# ============================================================
# Domain pattern (prod — stage suffix 없음)
#   FE: {project}.{domain}
#   BE: {project}-api.{domain}
# ============================================================
FE_DOMAIN="${PROJECT_NAME}.${DOMAIN}"
BE_DOMAIN="${PROJECT_NAME}-api.${DOMAIN}"

FE_URL="https://${FE_DOMAIN}"
BE_URL="https://${BE_DOMAIN}"
